# Copy to .env.local for local development. Never commit real values.
# In Vercel: Settings > Environment Variables (Production uses LIVE Stripe values).

# Stripe (server only). sk_test_... locally, sk_live_... in Production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# One-time EUR prices, one per plan (price_...). Test and live IDs differ.
STRIPE_PRICE_LITTLE=
STRIPE_PRICE_STORY=
STRIPE_PRICE_LEGACY=

# Site origin used for Stripe return URLs. Production: https://www.neexcreative.com
SITE_URL=http://localhost:3000

# Public (sent to the browser): the contact form endpoint (Formspree-compatible).
NEXT_PUBLIC_FORM_ENDPOINT=

# Upstash Redis (Vercel Marketplace, EU region eu-west-1): append-only acceptance
# log for voucher redemptions, and rate limiting. Added automatically by the
# Vercel integration. Without it, redemptions are refused (fail closed) and
# rate limiting falls back to per-instance memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string; salts the hashed IP used as a short-lived rate-limit key.
RATE_LIMIT_SALT=

# Public: Meta Pixel ID (digits only). Loads only after Advertising consent. Leave empty to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# Order confirmation email: OFF until a provider is chosen (see src/lib/sf-email.ts).
EMAIL_PROVIDER=
EMAIL_FROM=
